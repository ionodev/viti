{
  "name": "viti-desktop",
  "productName": "Viti",
  "version": "0.1.4",
  "private": true,
  "description": "Viti: a project page for any GitHub repository (boards, chat, to-dos, reports), as a Windows app",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "node app/dev.mjs",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "imapflow": "^1.7.8",
    "mailparser": "^3.14.1",
    "ws": "^8.22.1"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "author": "Varden Games",
  "build": {
    "appId": "com.vardengames.viti",
    "productName": "Viti",
    "copyright": "© 2026 Varden Games",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/dev.mjs",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viti",
      "artifactName": "Viti-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Viti-${version}-portable.${ext}"
    }
  }
}
