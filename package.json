{
  "name": "viti-desktop",
  "productName": "Viti",
  "version": "0.7.1",
  "private": true,
  "description": "Viti: a project page for any GitHub repository (boards, chat, to-dos, reports), for Windows, Mac and Linux",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "node app/dev.mjs",
    "dist": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "imapflow": "^1.7.8",
    "mailparser": "^3.14.1",
    "nodemailer": "^7.0.13",
    "ws": "^8.22.1"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "author": "ionodev",
  "build": {
    "appId": "io.github.ionodev.viti",
    "productName": "Viti",
    "copyright": "© 2026 ionodev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/dev.mjs",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viti",
      "artifactName": "Viti-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Viti-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ionodev",
        "repo": "viti",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Viti-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Viti-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "ionodev <ionodev@users.noreply.github.com>",
      "synopsis": "A shared workspace for your project on GitHub",
      "artifactName": "Viti-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "Viti-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Viti-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionodev/viti.git"
  },
  "homepage": "https://github.com/ionodev/viti"
}
